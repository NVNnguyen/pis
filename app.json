{
  "expo": {
    "name": "pis",
    "slug": "pis",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "sdkVersion": "52.0.0",
    "newArchEnabled": true,
    "scheme": "pis-app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.pis",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:pis-app.shop"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pis.pis",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logoApp.png",
        "backgroundColor": "#000000"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "pis-app.shop"
            },
            {
              "scheme": "pis-app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "extra": {
      "eas": {
        "projectId": "94603315-a1bb-48d8-b850-3a2ebbfa2506"
      }
    },
    "owner": "vietnguyen.world",
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": ""
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow this app to access your camera"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}