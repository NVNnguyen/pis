{
  "expo": {
    "name": "pis",
    "slug": "pis",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "newArchEnabled": true,
    "scheme": "vpis",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.pis",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:vpis.me"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pis.pis",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "vpis.me"
            },
            {
              "scheme": "vpis"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "extra": {
      "eas": {
        "projectId": "94603315-a1bb-48d8-b850-3a2ebbfa2506"
      }
    },
    "owner": "vietnguyen.world"
  },
  "web": {
    "bundler": "metro",
    "output": "static",
    "favicon": ""
  },
  "plugins": [
    [
      "expo-camera",
      {
        "cameraPermission": "Allow this app to access your camera"
      }
    ]
  ],
  "experiments": {
    "typedRoutes": true
  }
}